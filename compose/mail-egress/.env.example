# Egress mail node — copy to .env, fill in, chmod 600 .env
# Values come from the homelab launchmail deployment (secrets/launchmail.env).

# Homelab Postgres + Redis reachable over Tailscale. Use the homelab's MagicDNS
# name (e.g. homelab) or its 100.x tailnet IP. Ports are the launchmail internal
# ones exposed to the tailnet.
DATABASE_URL=postgresql://postgres:PASSWORD@homelab:5432/launchmail
REDIS_URL=redis://:PASSWORD@homelab:6379

# MUST be identical to the homelab launchmail MAIL_ENCRYPTION_KEY, or the worker
# can't decrypt DKIM keys / SMTP configs.
MAIL_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# This host's hostname whose PTR (reverse DNS) matches its public IP. Set it as
# the direct SMTP config's HELO hostname in the launchmail UI too.
MAIL_HELO_HOSTNAME=mail.ripieno.xyz
