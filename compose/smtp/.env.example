# Zkopíruj jako .env, vyplň, chmod 600 .env
# Brevo: registrace → Senders & Domains (ověř doménu, SPF+DKIM do Cloudflare DNS)
#        → SMTP & API → Generate SMTP key

SMTP_HELO_HOSTNAME=mail.TVOJE-DOMENA.cz
ALLOWED_SENDER_DOMAINS=TVOJE-DOMENA.cz
RELAYHOST=[smtp-relay.brevo.com]:587
RELAYHOST_USERNAME=tvuj-brevo-login@email.cz
RELAYHOST_PASSWORD=xsmtpsib-...
