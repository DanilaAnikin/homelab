# ============================================================================
# Self-hosted Supabase — environment (Strategie A). Copy to .env, fill in,
# chmod 600 .env. NEVER commit .env. Inject real values via Dokploy env UI.
#
# ⚠️ Every line marked "CHANGE — INSECURE DEFAULT" MUST be replaced. The demo
# values below (and upstream) are PUBLIC and signed with the demo secret — using
# them means anyone can forge a service_role token and bypass RLS entirely.
#
# Key generation (run these, paste the outputs):
#   POSTGRES_PASSWORD / SECRET_KEY_BASE / VAULT_ENC_KEY / PG_META_CRYPTO_KEY:
#     openssl rand -hex 32       (SECRET_KEY_BASE must be >= 64 chars → use -hex 32 = 64 hex)
#   REALTIME_DB_ENC_KEY:  exactly 16 chars →  openssl rand -hex 8
#   JWT_SECRET:  openssl rand -hex 32   (>= 40 chars)
#   DASHBOARD_PASSWORD:  openssl rand -base64 24
#   ANON_KEY / SERVICE_ROLE_KEY:  JWTs signed with JWT_SECRET (HS256), see below.
# ============================================================================

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=       # CHANGE — INSECURE DEFAULT (openssl rand -hex 32)
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── JWT + API keys (legacy/symmetric — what supabase-js expects) ─────────────
JWT_SECRET=              # CHANGE — INSECURE DEFAULT (openssl rand -hex 32, >=40 chars)
JWT_EXPIRY=3600
# ANON_KEY and SERVICE_ROLE_KEY are HS256 JWTs signed with JWT_SECRET above.
# Regenerate BOTH every time JWT_SECRET changes. Payloads:
#   { "role":"anon",         "iss":"supabase", "iat":<now>, "exp":<now+10y> }
#   { "role":"service_role", "iss":"supabase", "iat":<now>, "exp":<now+10y> }
# Generate (Node, needs `jsonwebtoken`):
#   JWT_SECRET=... node -e "const j=require('jsonwebtoken'),s=process.env.JWT_SECRET,iat=(Date.now()/1e3|0),exp=iat+3153600000;console.log('ANON_KEY='+j.sign({role:'anon',iss:'supabase',iat,exp},s));console.log('SERVICE_ROLE_KEY='+j.sign({role:'service_role',iss:'supabase',iat,exp},s))"
# (or the JWT generator widget in the Supabase self-hosting docs; verify at jwt.io)
ANON_KEY=               # CHANGE — INSECURE DEFAULT (regenerate from JWT_SECRET)
SERVICE_ROLE_KEY=       # CHANGE — INSECURE DEFAULT (regenerate from JWT_SECRET)
# New asymmetric keys — leave EMPTY to stay in legacy mode (recommended):
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ── Other service secrets (all CHANGE) ──────────────────────────────────────
SECRET_KEY_BASE=        # CHANGE — INSECURE DEFAULT (>=64 chars: openssl rand -hex 32)
VAULT_ENC_KEY=          # CHANGE — INSECURE DEFAULT (openssl rand -hex 32)
PG_META_CRYPTO_KEY=     # CHANGE — INSECURE DEFAULT (openssl rand -hex 32)
REALTIME_DB_ENC_KEY=    # CHANGE — INSECURE DEFAULT — EXACTLY 16 chars (openssl rand -hex 8)

# ── Dashboard (Studio) basic-auth via Kong ──────────────────────────────────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=     # CHANGE — INSECURE DEFAULT (openssl rand -base64 24)
STUDIO_DEFAULT_ORGANIZATION=Homelab
STUDIO_DEFAULT_PROJECT=freio

# ── Public URLs (per project — example: Freio) ──────────────────────────────
# Gateway public origin (Cloudflare Tunnel → kong:8000):
SUPABASE_PUBLIC_URL=https://supabase.freio.cz
# GoTrue external URL — MUST include /auth/v1 (origin-only breaks OAuth callbacks!):
API_EXTERNAL_URL=https://supabase.freio.cz/auth/v1
# Post-auth redirect target (your app):
SITE_URL=https://app.freio.cz
ADDITIONAL_REDIRECT_URLS=https://app.freio.cz/**,https://freio.cz/**

# ── Auth toggles ────────────────────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false       # false = require email confirmation
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false            # ⚠️ upstream default is TRUE — force off
ENABLE_PHONE_AUTOCONFIRM=false       # ⚠️ upstream default is TRUE — force off
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ── SMTP (GoTrue auth emails) → Seznam Email Profi / LaunchMail ─────────────
# Prefer 587 (STARTTLS); GoTrue is flaky on implicit-TLS 465.
SMTP_ADMIN_EMAIL=no-reply@freio.cz
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=587
SMTP_USER=no-reply@freio.cz
SMTP_PASS=                # mailbox app password
SMTP_SENDER_NAME=Freio

# ── Kong gateway ports (bind to loopback/Tailscale; only 8000 is tunneled) ──
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── PostgREST ───────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,graphql_public   # add ,storage only if a project needs it
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ── Storage backend → Cloudflare R2 (see README §R2). Filesystem is default;   ─
#    for R2 the override adds these to the storage service. ────────────────────
STORAGE_BACKEND=s3                       # "file" (volume) or "s3" (R2)
STORAGE_S3_BUCKET=freio-storage
STORAGE_S3_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ── Edge functions (only if a project uses them, e.g. hummy) ────────────────
FUNCTIONS_VERIFY_JWT=true

# ── Studio AI (optional) ────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Pooler (only if supavisor kept — we drop it; see override) ──────────────
POOLER_TENANT_ID=homelab
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_PROXY_PORT_TRANSACTION=6543
