# ─────────────────────────────────────────────────────────────────────────
# Production root .env  (used by docker-compose `env_file: .env`)
# Copy to `.env` on the server and fill in real values.
# ─────────────────────────────────────────────────────────────────────────

# Public origin of the app (the web domain). Used for invite links, tracking
# pixels, click/unsubscribe links, and Better Auth. In production set this to
# your real domain — everything is served same-origin and proxied to the API.
# Keep all three consistent with the web's published host port (3000 by default
# in docker-compose).
BETTER_AUTH_URL=https://your-domain.example
PUBLIC_API_URL=https://your-domain.example
WEB_ORIGIN=https://your-domain.example

# Better Auth signing secret — REQUIRED. Generate: `pnpx better-auth secret`
BETTER_AUTH_SECRET=your-secret-at-least-32-chars-long-replace-this

# REQUIRED — set once and NEVER change.
# Single secret behind BOTH the AES-256-GCM encryption of SMTP passwords and
# DKIM keys at rest AND the HMAC signing of public links (tracking pixels,
# click destinations, unsubscribe tokens). 32+ random chars.
# WARNING: rotating this value makes every stored SMTP password / DKIM key
# undecryptable and invalidates every signed link already sent. There is no
# fallback — the API and worker refuse to start if it is unset.
MAIL_ENCRYPTION_KEY=replace-me-32-plus-random-chars-set-once

# Database / Redis passwords for the bundled Postgres/Redis services.
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

# Optional — number of trusted reverse-proxy hops in front of the API, used to
# pick the real client IP from X-Forwarded-For on public form submissions.
# Default 0 (no proxy). Set to 1 when behind a single proxy/load balancer.
#TRUSTED_PROXY_COUNT=0
# Comma-separated trusted client-IP headers for Better Auth rate limiting.
# The default production ingress is Cloudflare Tunnel; keep the API private if
# you change this, and only name headers your ingress overwrites.
#BETTER_AUTH_IP_ADDRESS_HEADERS=cf-connecting-ip

# Optional — set to "true" to disable open/click tracking pixel + link
# injection globally. Default: tracking enabled.
#TRACKING_DISABLED=false

# Optional — port the API listens on inside its container. Default 5000.
# docker-compose expects 5000 (the web proxies to http://api:5000); only change
# this if you also adjust the compose service.
#PORT=5000

# NOTE: Do NOT set API_URL here for Docker — docker-compose pins the web's
# proxy target to http://api:5000 (the internal service) automatically.
# DATABASE_URL / REDIS_URL are also set by docker-compose to the internal
# postgres/redis services; you don't need them here.

# ─────────────────────────────────────────────────────────────────────────
# Local development only (not Docker): put these in apps/web/.env.local and a
# root .env.local instead — API runs on localhost:5000, web on localhost:3000.
#   DATABASE_URL=postgresql://postgres:password@localhost:5455/launchmail_dev
#   REDIS_URL=redis://localhost:6399
#   API_URL=http://localhost:5000
#
# CLI / MCP clients (apps/cli, apps/mcp) read these to reach the API:
#   LAUNCHMAIL_API_URL=http://localhost:5000   # default if unset
#   LAUNCHMAIL_API_KEY=lm_...                  # your API key
# ─────────────────────────────────────────────────────────────────────────
