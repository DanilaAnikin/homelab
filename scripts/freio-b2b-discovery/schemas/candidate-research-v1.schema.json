{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freio.cz/internal/schemas/b2b-discovery-candidates-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidates"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lead", "contact", "sourceUrl", "legalEntitySourceUrl"],
        "properties": {
          "lead": {
            "type": "object",
            "additionalProperties": false,
            "required": ["leadType", "name", "website", "ico", "legalForm"],
            "properties": {
              "leadType": { "enum": ["tutoring", "company", "school"] },
              "name": { "type": "string", "minLength": 2, "maxLength": 120 },
              "website": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#]+/$",
                "maxLength": 2000
              },
              "ico": {
                "type": "string",
                "pattern": "^[0-9]{8}$",
                "description": "Exact published Czech IČO; authoritative validation also requires the Czech checksum."
              },
              "legalForm": {
                "enum": [
                  "sro",
                  "as",
                  "zs",
                  "zu",
                  "ops",
                  "druzstvo",
                  "vos",
                  "ks",
                  "nadace",
                  "nadacni_fond",
                  "prispevkova_organizace",
                  "statni_prispevkova_organizace",
                  "skolska_pravnicka_osoba"
                ]
              },
              "category": { "type": "string", "minLength": 1, "maxLength": 120 },
              "region": { "type": "string", "minLength": 1, "maxLength": 120 },
              "city": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          },
          "contact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["email"],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 320,
                "pattern": "^(?:b2b|business|contact|education|hello|help|helpdesk|info|klienti|kontakt|kurzy|marketing|obchod|office|podpora|pr|recepce|reception|sales|sekretariat|skoleni|spoluprace|support|team|training|zakaznici)@[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.[a-z]{2,63}$"
              }
            }
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "legalEntitySourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
