[Unit]
Description=Homelab zaloha (Postgres + Dokploy config -> USB + R2)
Wants=network-online.target postiz-quiesce-recover.service postiz-backup-workspace-cleanup.service
Requires=docker.service
After=network-online.target docker.service postiz-quiesce-recover.service postiz-backup-workspace-cleanup.service
OnFailure=backup-notify-failure.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=homelab-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=homelab-backup
StateDirectoryMode=0700
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=8h
TimeoutStopSec=10min
ExecStartPre=/usr/local/sbin/postiz-quiesced-capture.sh --recover-only
ExecStartPre=/usr/local/sbin/postiz-backup-workspace-cleanup.sh --scope all
ExecStart=/usr/local/bin/homelab-backup.sh
ExecStopPost=/usr/local/sbin/postiz-quiesced-capture.sh --recover-only
ExecStopPost=/usr/local/sbin/postiz-backup-workspace-cleanup.sh --scope all
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectClock=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/homelab-backup /var/lib/homelab-backup
