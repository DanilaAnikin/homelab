[Unit]
Description=Renew TLS certificate for Tailscale-only Freio hosts
After=network-online.target docker.service
Wants=network-online.target docker.service
OnFailure=notify-failure@freio-private-cert-renew.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/freio-private-cert-renew
TimeoutStartSec=10min
Restart=on-failure
RestartSec=30min
RestartPreventExitStatus=78
PrivateTmp=true
NoNewPrivileges=true
