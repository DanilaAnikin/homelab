[Unit]
Description=End-to-end health check for Freio Tailnet-only ingress
After=network-online.target docker.service tailscaled.service freio-private-tailnet.service
Wants=network-online.target
Requires=freio-private-tailnet.service
OnFailure=notify-failure@freio-private-tailnet-check.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/freio-private-tailnet ensure
TimeoutStartSec=5min
PrivateTmp=true
NoNewPrivileges=true
