[Unit]
Description=Freio discovery spool retention
Documentation=file:/srv/homelab/docs/freio-prospecting-worker.md
ConditionPathExists=/etc/freio-prospecting/enabled/discovery-housekeeping
ConditionPathIsDirectory=/var/lib/freio-prospecting/ready
ConditionPathIsDirectory=/var/lib/freio-prospecting/deferred/untrusted
ConditionPathIsDirectory=/var/lib/freio-prospecting/quarantine/untrusted

[Service]
Type=oneshot
User=freio-discovery
Group=freio-prospecting
ExecStart=/usr/bin/python3 /srv/homelab/scripts/freio-prospecting/discover.py --spool /var/lib/freio-prospecting --housekeeping
TimeoutStartSec=2min
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/srv/homelab/scripts/freio-prospecting
ReadWritePaths=/var/lib/freio-prospecting/ready /var/lib/freio-prospecting/deferred/untrusted /var/lib/freio-prospecting/quarantine/untrusted
TasksMax=16
MemoryMax=128M
