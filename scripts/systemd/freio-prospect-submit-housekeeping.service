[Unit]
Description=Freio submit spool retention and crash reconciliation
Documentation=file:/srv/homelab/docs/freio-prospecting-worker.md
ConditionPathExists=/etc/freio-prospecting/enabled/submit-housekeeping
ConditionPathIsDirectory=/var/lib/freio-prospecting/processing
ConditionPathIsDirectory=/var/lib/freio-prospecting/processed
ConditionPathIsDirectory=/var/lib/freio-prospecting/state
ConditionPathIsDirectory=/var/lib/freio-prospecting/quarantine/claimed

[Service]
Type=oneshot
User=freio-submit
Group=freio-prospecting
LoadCredential=identity-index-hmac:/etc/freio-prospecting/identity-index-hmac
ExecStart=/usr/bin/python3 /srv/homelab/scripts/freio-prospecting/submit.py --spool /var/lib/freio-prospecting --housekeeping --identity-secret-file /run/credentials/freio-prospect-submit-housekeeping.service/identity-index-hmac
TimeoutStartSec=2min
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/srv/homelab/scripts/freio-prospecting
ReadWritePaths=/var/lib/freio-prospecting/processing /var/lib/freio-prospecting/processed /var/lib/freio-prospecting/state /var/lib/freio-prospecting/quarantine/claimed
TasksMax=16
MemoryMax=128M
