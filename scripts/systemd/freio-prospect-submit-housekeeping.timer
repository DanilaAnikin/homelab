[Unit]
Description=Disabled-by-default Freio submit retention schedule
Documentation=file:/srv/homelab/docs/freio-prospecting-worker.md

[Timer]
OnBootSec=25min
OnUnitActiveSec=6h
RandomizedDelaySec=15min
Persistent=true
Unit=freio-prospect-submit-housekeeping.service

[Install]
WantedBy=timers.target
