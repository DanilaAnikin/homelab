[Unit]
Description=Freio HMAC-authenticated prospect intake submission
Documentation=file:/srv/homelab/docs/freio-prospecting-worker.md
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/etc/freio-prospecting/enabled/submit
ConditionPathIsDirectory=/var/lib/freio-prospecting/ready
ConditionPathIsDirectory=/var/lib/freio-prospecting/processing
ConditionPathIsDirectory=/var/lib/freio-prospecting/processed
ConditionPathIsDirectory=/var/lib/freio-prospecting/quarantine/claimed

[Service]
Type=oneshot
User=freio-submit
Group=freio-prospecting
EnvironmentFile=/etc/freio-prospecting/submit.env
LoadCredential=submit-hmac:/etc/freio-prospecting/submit-hmac
ExecStart=/usr/bin/python3 /srv/homelab/scripts/freio-prospecting/submit.py --spool /var/lib/freio-prospecting --endpoint ${FREIO_PROSPECTING_ENDPOINT} --send --secret-file /run/credentials/freio-prospect-submit.service/submit-hmac --max-batches 10
TimeoutStartSec=2min
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/srv/homelab/scripts/freio-prospecting
ReadWritePaths=/var/lib/freio-prospecting
TasksMax=32
MemoryMax=256M
