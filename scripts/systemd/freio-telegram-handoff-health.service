[Unit]
Description=Verify Freio Telegram handoff timer and private heartbeat
Documentation=file:/srv/homelab/docs/freio-telegram-handoff.md
After=freio-telegram-handoff.timer
ConditionPathExists=/etc/freio-telegram-handoff/enabled
ConditionFileIsExecutable=/usr/local/libexec/freio-telegram-handoff-health
OnFailure=notify-failure@freio-telegram-handoff-health.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/freio-telegram-handoff-health
TimeoutStartSec=15s
LimitCORE=0

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/freio-telegram-handoff/enabled -/var/lib/private/freio-telegram-handoff
InaccessiblePaths=-/etc/homelab-telegram -/etc/freio-telegram-handoff/freio-machine-secret -/srv/frem/telegram-token -/srv/homelab/secrets
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
DevicePolicy=closed
KeyringMode=private
RemoveIPC=true
TasksMax=16
MemoryMax=64M
