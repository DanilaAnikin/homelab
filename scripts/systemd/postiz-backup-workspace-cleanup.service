[Unit]
Description=Reap interrupted root-only backup workspaces
After=systemd-tmpfiles-setup.service postiz-quiesce-recover.service
Wants=postiz-quiesce-recover.service
Before=backup.service frequent-db-backup.service
ConditionFileIsExecutable=/usr/local/sbin/postiz-backup-workspace-cleanup.sh
OnFailure=backup-notify-failure.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=homelab-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=homelab-backup
StateDirectoryMode=0700
TimeoutStartSec=5min
ExecStart=/usr/local/sbin/postiz-backup-workspace-cleanup.sh --scope all
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectClock=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/homelab-backup /var/lib/homelab-backup

[Install]
WantedBy=multi-user.target
