[Unit]
Description=Reap interrupted restore-drill plaintext and containers
Requires=docker.service
After=docker.service
Before=restore-drill.service
ConditionFileIsExecutable=/srv/homelab/self-healing/postiz-restore-drill.sh
ConditionFileIsExecutable=/srv/homelab/self-healing/restore-drill.sh
OnFailure=notify-failure@postiz-restore-cleanup.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=homelab-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=homelab-backup
StateDirectoryMode=0700
TimeoutStartSec=12min
ExecStart=/srv/homelab/self-healing/restore-drill.sh --cleanup-only
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectClock=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/homelab-backup /var/lib/homelab-backup

[Install]
WantedBy=multi-user.target
