[Unit]
Description=Tydenni restore drill (overeni obnovitelnosti zaloh do throwaway DB)
Wants=network-online.target postiz-quiesce-recover.service postiz-restore-cleanup.service
Requires=docker.service
After=network-online.target docker.service postiz-quiesce-recover.service postiz-restore-cleanup.service
OnFailure=notify-failure@restore-drill.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=homelab-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=homelab-backup
StateDirectoryMode=0700
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=8h
TimeoutStopSec=15min
ExecStartPre=/srv/homelab/self-healing/restore-drill.sh --cleanup-only
ExecStart=/srv/homelab/self-healing/restore-drill.sh
ExecStopPost=/srv/homelab/self-healing/restore-drill.sh --cleanup-only
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
# The bounded generic-stage capacity gate reads /proc/meminfo. Keep the full
# procfs API surface while ProtectProc still hides other users' process details.
ProcSubset=all
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectClock=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/homelab-backup /var/lib/homelab-backup
