[Unit]
Description=Homelab self-healing agent webhook (Kuma poll -> Claude Code)
After=network-online.target docker.service

[Service]
Type=simple
User=anakin
SupplementaryGroups=telegram-notify
ExecStart=/usr/bin/python3 /srv/homelab/self-healing/poller.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
